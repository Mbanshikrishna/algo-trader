# Broker selection: "angelone" (default) or "dhan"
# When "dhan", Dhan handles orders/positions; Angel One provides market data.
BROKER=angelone

# Angel One credentials (always required — used for market data at minimum)
ANGELONE_API_KEY=your_api_key
ANGELONE_CLIENT_ID=your_client_id
ANGELONE_PIN=your_pin
ANGELONE_TOTP_SECRET=your_totp_secret
ANGELONE_CLIENT_PUBLIC_IP=
ANGELONE_CLIENT_LOCAL_IP=
ANGELONE_CLIENT_MAC_ADDRESS=

# Dhan credentials (required when BROKER=dhan)
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_access_token

# Runtime settings
SCAN_INTERVAL_SECONDS=2
MONITOR_INTERVAL_SECONDS=10
ALERT_EVERY_CHECK=true
ORDER_PRODUCT_TYPE=INTRADAY
ORDER_VARIETY=NORMAL

# Risk settings
CAPITAL=100000
RISK_PER_TRADE_PCT=1.0
INTRADAY_LEVERAGE=5.0
MAX_CONSECUTIVE_LOSSES=2
SAFE_MODE=true
FNO_ONLY=false

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
