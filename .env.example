# Broker selection: "angelone" (default) or "dhan"
# When "dhan", Dhan handles orders/positions; Angel One provides market data.
BROKER=angelone

# Angel One credentials (always required — used for market data at minimum)
ANGELONE_API_KEY=your_api_key
ANGELONE_CLIENT_ID=your_client_id
ANGELONE_PIN=your_pin
ANGELONE_TOTP_SECRET=your_totp_secret
ANGELONE_CLIENT_PUBLIC_IP=
ANGELONE_CLIENT_LOCAL_IP=
ANGELONE_CLIENT_MAC_ADDRESS=

# Dhan credentials (required when BROKER=dhan)
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_access_token

# Runtime settings
PAPER_TRADE=true
LIVE_TRADING_ENABLED=false
# Required exact acknowledgement only when deliberately enabling live orders:
LIVE_TRADING_CONFIRMATION=
SCAN_INTERVAL_SECONDS=2
MONITOR_INTERVAL_SECONDS=10
ALERT_EVERY_CHECK=true
ORDER_PRODUCT_TYPE=INTRADAY
ORDER_VARIETY=NORMAL

# Risk settings
CAPITAL=100000
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=2.0
INTRADAY_LEVERAGE=5.0
MAX_CONSECUTIVE_LOSSES=2
SAFE_MODE=true
FNO_ONLY=false
RUNTIME_STATE_PATH=data/runtime_state.json
DAILY_RISK_STATE_PATH=data/daily_risk_state.json

# Append-only production decision snapshots and automatic replay comparison
DECISION_SNAPSHOTS_ENABLED=true
DECISION_JOURNAL_PATH=data/decision_journal.sqlite3
UNIVERSE_SNAPSHOT_DIR=data/universe_snapshots
AUTO_REPLAY_COMPARE=true
REPLAY_REPORT_DIR=data/replay_reports
BACKTEST_UNIVERSE_EXPORT=data/universe_snapshots.json

# Backtest execution assumptions. "auto" uses the newest confirmed-fill
# calibration and falls back to BACKTEST_FALLBACK_SLIPPAGE_BPS until one exists.
BACKTEST_SLIPPAGE_BPS=auto
BACKTEST_FALLBACK_SLIPPAGE_BPS=5
BACKTEST_FEES_BPS_PER_SIDE=10
BACKTEST_ASSUMED_SPREAD_BPS=10
# Wait for the next executable minute after the decision; avoids using price
# movement that happened before a real order could have filled.
BACKTEST_ENTRY_DELAY_MINUTES=1
BACKTEST_LOOKBACK_DAYS=365
# Optional reproducible period; set both or leave both blank.
BACKTEST_START_DATE=
BACKTEST_END_DATE=
# Production-equivalent default. FIVE_MINUTE/5 is a faster approximation.
BACKTEST_INTRADAY_INTERVAL=ONE_MINUTE
BACKTEST_SCAN_STEP_MINUTES=2
# risk = current safe sizing; logged_production_notional = legacy log sizing.
BACKTEST_SIZING_MODE=risk
# Candidate entry experiment. The command-line backtest defaults to these
# strict values; set 0.85/false/production to reproduce the old validator.
BACKTEST_ENTRY_RANGE_POSITION_MIN=0.95
BACKTEST_COMPLETED_MINUTE_VOLUME=true
BACKTEST_BREAKOUT_CONFIRMATION=persistence_or_retest
BACKTEST_BREAKOUT_PERSISTENCE_BARS=2
BACKTEST_BREAKOUT_RETEST_TOLERANCE_PCT=0.002
# Observation-derived staged-stop experiment. Keep false for the baseline;
# this affects backtests only and does not change production execution.
BACKTEST_STAGED_STOPS=false
# Test separately from staged stops. The floor includes modeled fees and exit
# slippage and activates only after the configured confirmed MFE.
BACKTEST_BREAK_EVEN_PLUS_COST=false
BACKTEST_BREAK_EVEN_TRIGGER_PCT=0.02
# Keep range requests below the broker's approximate 5,000-candle response cap.
BACKTEST_INTRADAY_CHUNK_DAYS=12
BACKTEST_INTRADAY_MAX_CALENDAR_DAYS=18
# Automatic pause/retry when the broker's rolling historical-data quota is full.
BACKTEST_RATE_LIMIT_COOLDOWN_SECONDS=65
BACKTEST_RATE_LIMIT_MAX_COOLDOWNS=60
BACKTEST_REPORT_DIR=data/production_backtest/reports
# Required for a production-grade run. JSON format is documented in README.
BACKTEST_POINT_IN_TIME_UNIVERSE=data/universe_snapshots.json
BACKTEST_REQUIRE_POINT_IN_TIME_UNIVERSE=true
# Leave 0 to scan the complete supplied universe.
BACKTEST_STOCK_LIMIT=0

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
